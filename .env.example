# Postgres / pgvector
POSTGRES_USER=deep_rag
POSTGRES_PASSWORD=deep_rag
POSTGRES_DB=deep_rag
POSTGRES_HOST=vector_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://deep_rag:deep_rag@vector_db:5432/deep_rag

# Model IDs
NEMOTRON_VL_MODEL_ID=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-FP8
NEMOTRON_TEXT_MODEL_ID=nvidia/NVIDIA-Nemotron-Nano-12B-v2
NEMOTRON_ONNX_PATH=backend_models/nemotron_12b_int8.onnx
GGUF_MODEL_PATH=backend_models/nemotron_12b_q4_k_m.gguf

# Inference configuration
INFERENCE_MODE=vl_fp8         # vl_fp8 | text_4bit | cpu_gguf
GPU_OFFLOAD_FRACTION=0.4

# LangGraph / RAG tuning
K_RETRIEVER=8
K_VEC=60
K_LEX=60
SYNTHESIZER_CONFIDENCE_THRESHOLD_DEFAULT=0.40
SYNTHESIZER_CONFIDENCE_THRESHOLD_EXPLICIT_SELECTION=0.30
